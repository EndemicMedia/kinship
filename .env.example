# Pollinations API Configuration
# Secret key (sk_ prefix) — add as POLLINATIONS_API_KEY in GitHub repo Settings → Secrets
# Used by scripts/generate-images.mjs during GitHub Actions build
POLLINATIONS_API_KEY=sk_your_key_here
# Expose to Vite for client-side live image loading (optional — images are pre-generated at build)
VITE_POLLINATIONS_API_KEY=sk_your_key_here

# API Base URLs
POLLINATIONS_IMAGE_URL=https://gen.pollinations.ai/image
POLLINATIONS_TEXT_URL=https://gen.pollinations.ai/v1

# Referrer ID for tracking (optional)
REFERRER_ID=kinship.app

# Environment (development | production)
NODE_ENV=development
